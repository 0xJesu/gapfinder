# Copy to .env (never commit real keys — .env is git-ignored).
# Windows PowerShell alternative: setx NVIDIA_API_KEY "nvapi-..." (then restart terminal)
# macOS/Linux: export NVIDIA_API_KEY="nvapi-..."

# NVIDIA NIM (build.nvidia.com) — powers ✨ AI engine: NVIDIA
NVIDIA_API_KEY=
# Any chat model your key can call (GET /v1/models). Verified working:
# openai/gpt-oss-20b (default), moonshotai/kimi-k3, z-ai/glm-5.3-flash
NVIDIA_MODEL=openai/gpt-oss-20b

# ScrapeGraphAI cloud — powers ✨ AI engine: ScrapeGraph
SGAI_API_KEY=

# Server bind
HOST=127.0.0.1
PORT=5000
